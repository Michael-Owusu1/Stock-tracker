import os
import requests
import matplotlib.pyplot as plt
import pandas as pd
from dotenv import load_dotenv

load_dotenv()
api_ = os.getenv('api_key')


def get_stock(symbol):
    url = 'https://www.alphavantage.co/query'

    params = {
        "function": "TIME_SERIES_DAILY",
        "symbol": symbol,
        "apikey": api_
    }

    response = requests.get(url, params = params)

    if response.status_code == 200:
        data = response.json()
        if "Time Series (Daily)" not in data:
            print("No time series data found.")
            return None
        return data
    else:
        print(f"Failed to retrieve data: {response.status_code}")
        return None
        

def search_company(keywords):
    url = 'https://www.alphavantage.co/query'
    
    params = {
        "function": "SYMBOL_SEARCH",
        "keywords": keywords,
        "apikey": api_
    }
    
    response = requests.get(url, params=params)
    
    if response.status_code == 200:
        data = response.json()
        if "bestMatches" not in data:
            print("No matches found.")
            return None
        return data
    else:
        print(f"Failed to retrieve data: {response.status_code}")
        return None


def display_search(data):
    matches = data["bestMatches"]

    for i, match in enumerate(matches, start=1):
        symbol = match["1. symbol"]
        name = match["2. name"]
        region = match["4. region"]

        print(f"{i}. {symbol} - {name}, {region}")

    return matches


def csv_(data, symbol):
    daily = data["Time Series (Daily)"]

    df = pd.DataFrame.from_dict(daily, orient="index")
    df.columns = [col.split(". ")[1] for col in df.columns] 
    df = df.astype(float)
    df.index.name = "date"
    df = df.sort_index()
    filename = f"{symbol}.csv"
    df.to_csv(filename)

    print(f"The data has been saved to this file: {filename}")
    return df


def calculate_moving_average(df, window=30):
    df["moving_avg"] = df["close"].rolling(window = window).mean()
    return df    

def plot_trends(df, symbol, window):
    plt.figure(figsize=(10, 5))
    plt.plot(df.index, df["close"], label = "Closing Price")
    plt.plot(df.index, df["moving_avg"], label = f"{window} day/s Moving Average")
    plt.title(f"{symbol}'s Trending Price")
    plt.xlabel("Date")
    plt.ylabel("Price")
    step = max(1, len(df.index) // 15)
    plt.xticks(ticks=range(0, len(df.index), step), labels=df.index[::step], rotation=45)
    plt.legend()
    plt.tight_layout()
    plt.show()


def display_trends(df, symbol, window):
    latest = df.iloc[-1]
    latest_close = latest["close"]
    latest_avg = latest["moving_avg"]
    print(f"\n {symbol} Trend Summary ")
    print(f"The Latest Closing Price: {latest_close:.2f}")

    if pd.isna(latest_avg):
        print("There is not enough data to calculate the moving average.")
    else:
        print(f"{window} day/s Moving Average: {latest_avg:.2f}  ")

        if latest_close > latest_avg:
            print("There is an upwards trend!! Closing Price is ABOVE the moving average. ")
        else:
            print("There is a downwards trend!! Closing Price is BELOW the moving average.")

    print("\nRecent data:")
    print(df.tail(10))


def main():
    keywords = input("Enter a company: ").upper()
    results = search_company(keywords)

    if not results:
        return

    if not results or not results.get("bestMatches"):
        print("No matches found for that company. Try a different name.")
        return

    matches = display_search(results)

    choice = input("\nEnter the number of the company's name you are looking for: ")
    try:
        index = int(choice) - 1
        symbol = matches[index]["1. symbol"]
    except(ValueError, IndexError):
        print("Invalid selection")
        return

    data = get_stock(symbol)
    if not data:
        return

    window_input = input("Enter the amount of days you would like to see for the moving average: ")

    try:
        window = int(window_input)
    except ValueError:
        print("Invalid input, the selected number will be 30")
        window = 30
    

    df = csv_(data, symbol)
    df = calculate_moving_average(df, window=window)
    display_trends(df, symbol, window)
    plot_trends(df, symbol, window)


if __name__ == '__main__':
    main()